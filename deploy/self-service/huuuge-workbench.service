[Unit]
Description=Huuuge self-service web application (TASK-0037)
After=network-online.target
Wants=network-online.target

[Service]
User=huuuge-workbench
Group=huuuge-workbench
WorkingDirectory=/srv/huuuge-self-service/current
Environment=HUUUGE_WORKBENCH_CONFIG=/etc/huuuge-self-service/workbench.json
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TZ=UTC
ExecStart=/srv/huuuge-self-service/venv/bin/python -m self_service.app
Restart=on-failure
RestartSec=3
MemoryMax=256M
CPUQuota=50%
TasksMax=32
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/huuuge-self-service/data
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
